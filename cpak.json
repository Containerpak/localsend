{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "LocalSend",
  "description": "Share files with nearby devices over the local network.",
  "version": "1.18.2",
  "image": "ghcr.io/containerpak/localsend@sha256:6861c6a87ba74ccc340ab4d9e842b497f75caa3be153a511e076a6d0d54d83ac",
  "binaries": [
    "/usr/bin/localsend_app"
  ],
  "desktop_entries": [
    "/usr/share/applications/localsend_app.desktop"
  ],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "displayX11": false,
    "socketWayland": true,
    "socketPulseAudio": false,
    "socketSshAgent": false,
    "socketCups": false,
    "socketGpgAgent": false,
    "bluetooth": false,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": true,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": true,
    "openURI": true,
    "hostApplications": false,
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "env": [],
    "network": true,
    "hostNetwork": true,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
